{
  "name": "wifi-vault",
  "version": "1.0.0",
  "description": "View Wi-Fi passwords saved on this PC",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
